<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar senha - ConectaVida</title>
    <link rel="stylesheet" href="/css/estilos.css" />
  </head>
  <body>
    <main class="acesso-shell">
      <div class="acesso-card">
        <div class="acesso-header">
          <div class="acesso-logo-wrap">
            <img src="/img/marca.svg" alt="ConectaVida" class="acesso-logo" />
          </div>
          <span class="acesso-badge">Recuperação</span>
          <h1>Esqueci minha senha</h1>
          <p>Digite seu e-mail para receber um link de redefinição de senha.</p>
        </div>

        <% if (erro) { %><p class="erro"><%= erro %></p><% } %>
        <% if (sucesso) { %><p class="sucesso"><%= sucesso %></p><% } %>

        <form action="/esqueci-senha" method="POST" class="acesso-form">
          <input type="email" name="email" placeholder="Seu e-mail cadastrado" required />
          <button type="submit" class="btn">Enviar link</button>
        </form>

        <p class="acesso-link"><a href="/entrar">Voltar para entrar</a></p>
      </div>
    </main>
    <%- include('componentes/rodape') %>
  </body>
</html>
