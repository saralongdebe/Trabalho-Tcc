PORT=3000
HOST=0.0.0.0
SESSION_SECRET=troque-por-uma-chave-forte

# MongoDB local ou em nuvem
MONGO_URI=mongodb://127.0.0.1:27017/conectavida
# Para Render / Atlas, use a URL do MongoDB em nuvem em vez do localhost:
# MONGO_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@clusterxxxxx.mongodb.net/conectavida?retryWrites=true&w=majority
# Alternativa compatível com nome mais comum em produção:
# MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@clusterxxxxx.mongodb.net/conectavida?retryWrites=true&w=majority

# Gmail SMTP (usar App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email-real@gmail.com
EMAIL_PASS=senha-de-app-do-google
EMAIL_FROM=ConectaVida <seu-email-real@gmail.com>

# URL pública do projeto
BASE_URL=http://localhost:3000
